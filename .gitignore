# Python, Jupyter, GIS, and operating-system files
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.env
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credentials and local configuration
*.pem
*.key
credentials*
secrets*

# Large geospatial and imagery data; keep metadata and approved small samples instead
*.tif
*.tiff
*.jp2
*.img
*.hdf
*.nc
*.grib
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
